# Copy to .env. Defaults target the kontestis development stack running on this machine.
DATABASE_URL=postgresql://kontestis:kontestis@localhost:5432/forge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=root
S3_SECRET_KEY=password
S3_BUCKET=forge-blobs

# evaluator: the kontestis evaluator over Redis. local: unsandboxed, development only.
RUNNER=evaluator
# Queue the evaluator instances consume. Use the judge's queue to share its instances.
EVALUATOR_QUEUE_KEY=forge_evaluator_queue
# number (evaluator master, what kontestis sends) | string | auto (probe on first use)
EVALUATOR_ID_FORMAT=auto
RUNNER_POOL=dev
RUNNER_HARDWARE_CLASS=dev-laptop

# Password-less login for local development. Never enable in production.
AUTH_DEV_LOGIN=true

# Sign in with kontestis (OAuth 2.0 authorization code flow, kontestis PR #146)
# OAUTH_CLIENT_ID=forge
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTHORIZE_URL=http://localhost:3100/oauth/authorize
# OAUTH_TOKEN_URL=http://localhost:8080/api/oauth/token
# OAUTH_USERINFO_URL=http://localhost:8080/api/oauth/userinfo
