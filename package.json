{
    "name": "kontestis-forge",
    "private": true,
    "packageManager": "pnpm@9.10.0",
    "engines": { "node": ">=22" },
    "scripts": {
        "dev": "pnpm -r --parallel --filter @forge/api --filter @forge/web dev",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "e2e": "pnpm --filter @forge/e2e test"
    }
}
